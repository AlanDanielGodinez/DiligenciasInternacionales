# Backend heredado (MongoDB). No usar en producción; se retirará en la Fase 1.
# Nunca coloque valores reales en este archivo.
# PostgreSQL (Cloud SQL)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_db_user
PGPASSWORD=
PG_SSL=false

# Server
PORT=5000

# JWT
JWT_SECRET=
# ============================================
# BACKEND DILIGENCIAS INTERNACIONALES - CONFIG
# ============================================

# Servidor
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/diligencias

# JWT
JWT_SECRET=
JWT_EXPIRE=7d

# Google Sheets API
GOOGLE_API_KEY=

# Google Sheets IDs (proporcionados)
GOOGLE_SHEET_GESTION_AMA_ID=
GOOGLE_SHEET_PERFILES_ID=
GOOGLE_SHEET_VISA_PASSPORT_ID=
GOOGLE_SHEET_INFORMES_PAGOS_ID=
GOOGLE_SHEET_BD_LEGALES_ID=

# Webhook
WEBHOOK_SECRET_KEY=

QB_BASE_URL=https://sandbox-quickbooks.api.intuit.com

# (Opcional) Intervalos por defecto
SYNC_INTERVAL_USERS=*/5 * * * *
SYNC_INTERVAL_DILIGENCIAS=*/10 * * * *
SYNC_INTERVAL_DOCUMENTOS=*/15 * * * *
SYNC_INTERVAL_FULL=0 * * * *
