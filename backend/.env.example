PORT=5000
DB_HOST=
DB_PORT=5432
DB_NAME=diligencias
DB_USER=
DB_PASSWORD=
DB_SSL=false
GOOGLE_DRIVE_APPSHEET_ROOT_FOLDER_ID=
GOOGLE_DRIVE_EXPEDIENTES_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_DEFAULT_VISIBILITY=private

# Feeds RSS oficiales opcionales, separados por comas. Se consultan primero.
# Solo se aceptan URLs HTTPS de travel.state.gov o mx.usembassy.gov.
NEWS_MIGRATION_RSS_URLS=
# Si RSS no devuelve resultados, el backend consulta automáticamente:
# https://travel.state.gov/content/travel/en/News/visas-news.html
# Respaldo manual normalizado en una sola línea. Se usa únicamente si fallan
# las fuentes dinámicas oficiales.
NEWS_MIGRATION_ITEMS_JSON=
NEWS_MIGRATION_TIMEOUT_MS=5000

QB_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# --- Autenticación (obligatorio) ---
# Secreto aleatorio >= 32 caracteres. El servidor NO arranca sin él. Nunca lo versione.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión en horas (1-72, por defecto 12)
AUTH_TOKEN_TTL_HOURS=12
# Intentos de login por 15 minutos
AUTH_LOGIN_MAX_PER_ACCOUNT=8
AUTH_LOGIN_MAX_PER_IP=50
API_RATE_LIMIT_PER_MINUTE=600
# Orígenes permitidos para CORS (separados por coma). Obligatorio en producción.
CORS_ORIGINS=http://localhost:3000
# Detrás de un proxy/balanceador (Cloud Run, Nginx): TRUST_PROXY=1
TRUST_PROXY=
# Acceso a documentos de clientes: "area" (responsable/área actual/Admin; por defecto)
# o "authenticated" (cualquier empleado con sesión; solo temporal).
DOCUMENT_ACCESS_POLICY=area
# QuickBooks Online OAuth 2.0 (usar sandbox inicialmente)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/integraciones/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
# Clave aleatoria de 32 bytes, codificada como base64 o 64 caracteres hex.
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
