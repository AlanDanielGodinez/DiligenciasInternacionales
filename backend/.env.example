# Feeds RSS oficiales opcionales, separados por comas. Se consultan primero.
# Solo se aceptan URLs HTTPS de travel.state.gov o mx.usembassy.gov.
NEWS_MIGRATION_RSS_URLS=
# Si RSS no devuelve resultados, el backend consulta automáticamente:
# https://travel.state.gov/content/travel/en/News/visas-news.html
# Respaldo manual normalizado en una sola línea. Se usa únicamente si fallan
# las fuentes dinámicas oficiales.
NEWS_MIGRATION_ITEMS_JSON=
NEWS_MIGRATION_TIMEOUT_MS=5000

